<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 拍照临时文件：写到应用私有目录，再经 FileProvider 授权给相机 -->
    <cache-path
        name="captures"
        path="captures/" />
    <cache-path
        name="images"
        path="images/" />
    <!-- 更新包下载目录：UpdateRepository.downloadApk() 实际写 context.cacheDir/updates/ -->
    <cache-path
        name="updates"
        path="updates/" />
    <files-path
        name="offline"
        path="offline/" />
    <!-- 拍照留痕暂存目录：CaptureScreen.newPhotoFile() 实际写 context.filesDir/captures/ -->
    <files-path
        name="captures_files"
        path="captures/" />
</paths>

{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    // 不再写 baseUrl：TS 6.0 起 baseUrl 已弃用（7.0 移除），且它已不再作为模块查找根。
    // paths 的取值本来就相对本文件所在目录解析，原先 baseUrl 是 "."、写法是 "./src/*"，
    // 所以删掉它解析结果一字不差。全仓非相对导入只有真实包名（vue/axios/element-plus 等），
    // 没有任何一处依赖 baseUrl 兜底。
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"],
    // -b 模式必然写增量信息，默认落在项目根目录；统一挪进 node_modules
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "test/**/*.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    // ⚠️ composite 项目必须产出声明文件，默认会落在 vite.config.ts 旁边生成
    // vite.config.js + vite.config.d.ts。而 Vite 的配置查找顺序里 .js 优先于 .ts，
    // 于是「改了 vite.config.ts 却不生效」——构建产物里根本没有改动。
    // 把产物挪进 node_modules（已被忽略），从根上避免遮蔽源配置。
    "outDir": "./node_modules/.cache/tsc-node",
    "tsBuildInfoFile": "./node_modules/.cache/tsc-node/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}

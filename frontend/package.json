{
  "name": "village-population-frontend",
  "version": "2.1.0",
  "description": "村级人口与重点人群精细化管理系统 - 前端",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"scripts/**/*.cjs\" \"*.mjs\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"scripts/**/*.cjs\" \"*.mjs\" \"*.ts\"",
    "check:icons": "node scripts/check-icons.cjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.2",
    "echarts": "^5.5.1",
    "element-plus": "^2.7.8",
    "pinia": "^2.1.7",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.9.10",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^5.3.4",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.26"
  }
}

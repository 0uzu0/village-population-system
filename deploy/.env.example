# =============================================================
# 环境变量示例 —— 复制为 .env 并填写真实值
# 严禁将本文件中的真实密码提交到 Git 仓库（.env 已在 .gitignore）
# =============================================================

# ---- 镜像版本 ----
# 生产环境请固定到具体版本号（如 v1.0.0），不要长期使用 latest
VERSION=v1.0.0
# 镜像前缀：替换为你的 GitHub 仓库（ghcr.io/组织或用户名/仓库名）
FRONTEND_IMAGE=ghcr.io/OWNER/REPO-frontend
BACKEND_IMAGE=ghcr.io/OWNER/REPO-backend

# ---- 端口 ----
HTTP_PORT=80

# ---- 数据库凭证（务必修改为强密码） ----
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=village_population
MYSQL_USER=village
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# ---- 应用安全（务必修改） ----
# 生成示例：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=12h

# ---- 初始管理员（首次启动自动创建） ----
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_INIT_NAME=系统管理员

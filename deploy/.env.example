# =============================================================
# 环境变量示例 —— 复制为 .env 并填写真实值
# 严禁将本文件中的真实密码提交到 Git 仓库（.env 已在 .gitignore）
# =============================================================

# ---- 镜像版本 ----
# 版本策略（三选一）：
#   latest        每次更新前需先 docker compose pull（最省事）
#   2.2.3         语义化版本：推送 git tag v2.2.3 后自动生成，回滚最方便（推荐）
#   sha-2baba22   按提交哈希精确固定（Actions 每次构建都会生成）
# ⚠️ 注意 v 前缀：git 标签是 v2.2.3，镜像标签是 2.2.3（不带 v）。此处填的是**镜像标签**，
#    写 VERSION=v2.2.3 会去拉一个不存在的镜像。用 scripts/update.sh 时两种写法都接受，
#    脚本会自动去掉 v。
VERSION=latest
# 镜像地址（GHCR，由 GitHub Actions 自动构建发布）
# NAS 等部署机拉取前，先在 GitHub 网页把两个 Package 设为 Public（否则需要 docker login）
FRONTEND_IMAGE=ghcr.io/0uzu0/village-population-system-frontend
BACKEND_IMAGE=ghcr.io/0uzu0/village-population-system-backend

# ---- 端口 ----
HTTP_PORT=80

# ---- 附件（现场照片 / 合同扫描件）存放目录 ----
# 这是**宿主机上的真实路径**，容器里的 /app/uploads 直接绑到这里（相对路径以 deploy/ 为基准）。
# 为什么不用 docker named volume：附件是唯一无法靠重新部署恢复的东西，绑到宿主机目录后
# 备份就是 cp/tar/rsync 一个普通文件夹，也能在需要时直接翻目录核对。
# 建议改成绝对路径（例如 NAS 上的共享盘），例如：UPLOAD_DIR_HOST=/volume1/village-files/uploads
UPLOAD_DIR_HOST=./data/uploads

# ---- 数据库凭证（务必修改为强密码） ----
# ⚠️ 密码字符规范（重要）：
#   - 禁用 `$`（Compose 会当变量引用展开）和 `#`（其后内容被当注释截断）
#   - 不要加引号、前后不留空格
#   - 推荐：openssl rand -hex 16 生成（纯字母数字，最稳）
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=village_population
MYSQL_USER=village
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
# 注意：MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD 只在 mysql_data 卷「首次初始化」时生效；
# 之后再改密码必须执行 scripts/fix-mysql-auth.sh 同步账号，否则后端报 1045。

# ---- 应用安全（务必修改） ----
# 生成示例：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# ---- 跨域来源（一般留空） ----
# 默认留空 = 后端不返回任何跨域许可。本项目的正常部署是同源的：浏览器只访问 frontend
# 的 nginx，由它把 /api 反代到 backend:8080，backend 端口不对宿主机暴露，所以不需要 CORS。
# 只有在「前端单独部署在另一个域名/端口」时才需要填，多个来源用英文逗号分隔，例如：
#   CORS_ORIGIN=https://admin.example.com,https://village.example.com
# 注意：写 * 等于放开任意来源读取 API 响应，不要在生产用。
CORS_ORIGIN=


# ---- 初始管理员（首次启动自动创建） ----
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_INIT_NAME=系统管理员

# ---- MCP（AI 工具接口）----
# 端点为 POST /api/mcp，权限沿用网页的账号与权限码，不需要额外开账号。
#
# 接入方式（推荐）：网页「系统设置 → AI 接入」新建一枚长期令牌，页面会直接给出
# 下面这段配置，复制到客户端的 mcpServers 里即可：
#   { "mcpServers": { "village": {
#       "type": "http",
#       "url": "http://<你的地址>/api/mcp",
#       "headers": { "Authorization": "Bearer vpm_xxxxxxxx" } } } }
# 令牌长期有效、可单独吊销、可限定只读；改密码或停用账号会让全部令牌立刻失效。
#
# 临时使用也可以直接拿网页登录的 JWT（7 天有效）：
#   curl -s -X POST http://<地址>/api/auth/login -H 'Content-Type: application/json' \
#        -d '{"username":"admin","password":"..."}'   # 取 data.token
#
# 写入等级：off 只读 / basic 可建档、记账、确认待核查 / full 额外含批量与高危操作。
# 建议长期保持 off；确实要让 AI 代录数据时再改 basic。
MCP_WRITE_LEVEL=off
# 敏感字段脱敏：mask 打码（默认） / full 明文。明文会让身份证号进入模型上下文，
# 除非模型部署在你自己可控的机器上，否则不要改。
# 写法容错：带引号、"full" 后面多一个空格、Windows 编辑器的 CRLF、写成 FULL，
# 都会被自动归一，不必纠结格式。但**改完必须重建容器**：
#   docker compose up -d --force-recreate backend
# 只 restart 不重建，进程读到的仍是创建容器时的旧环境变量。
# 改了没生效时依次查：
#   docker inspect vp-backend --format '{{json .Config.Env}}' | tr ',' '\n' | grep MCP
#   curl -s -H "Authorization: Bearer <令牌>" http://<地址>/api/mcp/manifest
# manifest 的 piiMode 是生效值、piiRaw 是容器里看到的原文；
# piiRecognized=false 说明值写错了，启动日志也会打一条 mcp-config-unrecognized。
MCP_PII_MODE=mask
# 删除类工具（人员删除、批量删除等）的独立开关。
# 即使 MCP_WRITE_LEVEL=full，这里不是 true 也不会注册删除工具。
MCP_ALLOW_DESTRUCTIVE=false

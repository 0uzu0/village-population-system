# =============================================================
# 后端环境变量示例（严禁填写真实密码后提交）
# 复制为 .env 使用：cp .env.example .env
# =============================================================

# 服务
PORT=8080
NODE_ENV=development

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=village_population
DB_USER=village
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=12h

# 初始管理员（首次启动自动创建）
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=Admin@123456
ADMIN_INIT_NAME=系统管理员

# CORS 允许来源（前端地址）
CORS_ORIGIN=http://localhost:5173

# 文件上传目录
UPLOAD_DIR=./uploads
